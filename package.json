{
  "name": "testing-skipped-builds-turboskip",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic --project-token=chpt_01bcf6348fee1d7",
    "chromatic:skip": "chromatic --project-token=chpt_01bcf6348fee1d7 --skip --exit-zero-on-changes",
    "chromatic:turbosnap": "chromatic --project-token=chpt_01bcf6348fee1d7 --only-changed --exit-zero-on-changes",
    "chromatic:all": "chromatic --project-token=chpt_01bcf6348fee1d7",
    "chromatic:externals": "chromatic --project-token=chpt_01bcf6348fee1d7 --only-changed --exit-zero-on-changes --externals \"public/**\"",
    "chromatic:untraced": "chromatic --project-token=chpt_01bcf6348fee1d7 --only-changed --exit-zero-on-changes --untraced \"modes-config/**\"",
    "chromatic:untraced-externals": "chromatic --project-token=chpt_01bcf6348fee1d7 --only-changed --exit-zero-on-changes --untraced \"modes-config/**\" --externals \"public/**\"",
    "chromatic:onlystoryfiles": "chromatic --project-token=chpt_01bcf6348fee1d7 --only-changed --exit-zero-on-changes --only-story-files \"src/components/animations/**/*.stories.tsx\"",
    "chromatic:onlystorynames": "chromatic --project-token=chpt_01bcf6348fee1d7 --only-changed --exit-zero-on-changes --only-story-names \"Animations/*\""
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@internationalized/date": "^3.12.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "chromatic": "^18.2.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "storybook": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "vitest": "latest",
    "playwright": "latest",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest"
  }
}
